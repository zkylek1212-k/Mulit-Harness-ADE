{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Workbench",
  "version": "0.1.48",
  "identifier": "io.github.zkylek1212-k.agent-workbench",
  "build": { "frontendDist": "../../../out/desktop" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../../build/icon.ico", "../../../build/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
